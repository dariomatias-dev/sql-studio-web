# Canonical site URL, used for absolute links and metadata.
NEXT_PUBLIC_SITE_URL=https://sql-studio.vercel.app

# EmailJS credentials for /contact and /download. Without these, both
# forms show a friendly error instead of sending (see src/shared/lib/email.ts).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
